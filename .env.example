# =====================================================================
# SIH26100 - AI-Powered Integrated Bid Compliance Verification Platform
# Environment Configuration Template (.env.example)
# =====================================================================

# Application Configuration
APP_NAME="SIH26100 Procurement Platform"
APP_ENV="development" # development | testing | production
LOG_LEVEL="INFO"
SECRET_KEY="dev-secret-key-change-in-production-min-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# API Settings
API_V1_STR="/api/v1"
PROJECT_NAME="SIH26100 GeM Procurement Compliance Platform"
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# PostgreSQL Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="sih_user"
POSTGRES_PASSWORD="sih_password"
POSTGRES_DB="sih26100_db"
DATABASE_URL="postgresql+psycopg://sih_user:sih_password@localhost:5432/sih26100_db"

# Redis Queue & Cache Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"

# MinIO Object Storage Configuration
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="sih26100-documents"
MINIO_SECURE=false

# Seed Data Options
SEED_DEMO_DATA=true
